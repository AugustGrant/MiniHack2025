        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "228cc6a0-f7e0-4d7c-b8b9-543f14aa573b"
      }
